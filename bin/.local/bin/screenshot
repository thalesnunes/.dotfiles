#!/usr/bin/env bash

# Unified screenshot utility for Sway / Wayland
# Subcommands: window (default), ocr, active, output

FREEZE_PID=""
cleanup_freeze() {
  if [[ -n "$FREEZE_PID" ]]; then
    kill "$FREEZE_PID" 2>/dev/null
  fi
}
trap cleanup_freeze EXIT

freeze_screen() {
  if command -v hyprpicker >/dev/null 2>&1; then
    hyprpicker -r -z >/dev/null 2>&1 &
    FREEZE_PID=$!
    sleep 0.1
  fi
}

notify_ok() {
  notify-send -t 3000 -a "Screenshot" "$1" "${2:-}"
}

cmd_window() {
  freeze_screen
  local window_rects geom
  window_rects=$(swaymsg -t get_tree 2>/dev/null | jq -r '.. | select(.pid? and .visible?) | .rect | "\(.x),\(.y) \(.width)x\(.height)"' 2>/dev/null)

  if [[ -n "$window_rects" ]]; then
    geom=$(echo "$window_rects" | slurp -o 2>/dev/null)
  else
    geom=$(slurp 2>/dev/null)
  fi

  [[ -z "$geom" ]] && exit 0

  grim -g "$geom" - | wl-copy --type image/png || exit 1
  notify_ok "Selection copied to clipboard"
}

cmd_ocr() {
  freeze_screen
  local selection
  selection=$(slurp 2>/dev/null)
  [[ -z "$selection" ]] && exit 0

  # Determine OCR languages (supporting English and Portuguese BR)
  local langs
  if [[ -n "${OCR_LANGS:-}" ]]; then
    langs="$OCR_LANGS"
  else
    local available_langs detected=()
    available_langs=$(tesseract --list-langs 2>/dev/null | tail -n +2 | grep -v '^osd$')
    for lang in eng por; do
      if echo "$available_langs" | grep -qx "$lang"; then
        detected+=("$lang")
      fi
    done

    if ((${#detected[@]} > 0)); then
      langs=$(IFS=+; echo "${detected[*]}")
    elif [[ -n "$available_langs" ]]; then
      langs=$(echo "$available_langs" | head -n 1)
    else
      langs="eng"
    fi
  fi

  local text text_trimmed
  text=$(grim -g "$selection" - | tesseract stdin stdout --oem 1 --psm 6 -l "$langs" --dpi 300 -c preserve_interword_spaces=1 2>/dev/null) || exit 1
  text_trimmed=$(echo "$text" | sed -e 's/[[:space:]]*$//')

  if [[ -z "$text_trimmed" ]]; then
    notify-send -t 3000 -a "Screenshot OCR" "No text detected in selection"
    exit 0
  fi

  printf "%s" "$text_trimmed" | wl-copy
  notify-send -t 3000 -a "Screenshot OCR" "Copied text to clipboard" "$text_trimmed"
}

cmd_active() {
  local geom
  geom=$(swaymsg -t get_tree 2>/dev/null | jq -r '.. | select(.focused? == true) | .rect | "\(.x),\(.y) \(.width)x\(.height)"' 2>/dev/null)
  [[ -z "$geom" ]] && exit 1

  grim -g "$geom" - | wl-copy --type image/png || exit 1
  notify_ok "Active window copied to clipboard"
}

cmd_output() {
  local output
  output=$(swaymsg -t get_outputs 2>/dev/null | jq -r '.[] | select(.focused) | .name' 2>/dev/null)

  if [[ -n "$output" ]]; then
    grim -o "$output" - | wl-copy --type image/png || exit 1
  else
    grim - | wl-copy --type image/png || exit 1
  fi
  notify_ok "Screen copied to clipboard"
}

case "${1:-window}" in
  ocr|text)
    cmd_ocr
    ;;
  active)
    cmd_active
    ;;
  output|screen)
    cmd_output
    ;;
  window|region|anything|*)
    cmd_window
    ;;
esac
